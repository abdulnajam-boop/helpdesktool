[Unit]
Description=Helpdesktool Linux Endpoint Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=helpdesk-agent
Group=helpdesk-agent
ExecStart=/opt/helpdesktool/venv/bin/helpdesk-linux-agent --config /etc/helpdesktool/agent.json
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/helpdesktool
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
