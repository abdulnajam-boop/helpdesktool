POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-with-a-long-random-password
HELPDESK_DATABASE_URL=postgresql+psycopg://helpdesk:replace-with-a-long-random-password@db:5432/helpdesk
HELPDESK_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
HELPDESK_JOB_CLAIM_SECRET=replace-with-a-different-long-random-secret
HELPDESK_ENVIRONMENT=development
HELPDESK_SERVICE_ALLOWLIST=helpdesk-demo.service
HELPDESK_WEBHOOK_ALLOW_HTTP=false
HELPDESK_WEBHOOK_TIMEOUT_SECONDS=10
HELPDESK_WEBHOOK_MAX_ATTEMPTS=8
HELPDESK_WEBHOOK_SECRET_N8N=replace-with-a-dedicated-webhook-signing-secret
