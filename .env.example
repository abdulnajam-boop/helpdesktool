POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-with-a-long-random-password
HELPDESK_DATABASE_URL=postgresql+psycopg://helpdesk:replace-with-a-long-random-password@db:5432/helpdesk
# Password for the restricted "helpdesk_app" database role that the API and
# webhook worker actually connect as at runtime (migrations still use
# HELPDESK_DATABASE_URL's superuser role). Migration 0005 creates this role
# with this password. Must differ from HELPDESK_DATABASE_URL's password.
HELPDESK_APP_ROLE_PASSWORD=replace-with-a-different-long-random-password
HELPDESK_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
HELPDESK_JOB_CLAIM_SECRET=replace-with-a-different-long-random-secret
# Seeds the Ed25519 keypair job envelopes are signed with (helpdesktool/job_signing.py).
# Never stored -- the private key is derived from this on every process start, so it
# must stay the same across restarts or every agent that already pinned the public key
# will start failing closed on every job. Must differ from the other secrets above.
HELPDESK_JOB_SIGNING_SEED=replace-with-a-third-long-random-secret
HELPDESK_ENVIRONMENT=development
HELPDESK_ALLOW_INSECURE_HEADER_AUTH=true
HELPDESK_DEVELOPMENT_LOGIN_ENABLED=true
HELPDESK_DEVELOPMENT_SESSION_SECRET=replace-with-a-long-random-development-secret
HELPDESK_CORS_ORIGINS=http://localhost:3000
HELPDESK_LOW_DISK_THRESHOLD_PERCENT=85
HELPDESK_SERVICE_ALLOWLIST=helpdesk-demo.service
HELPDESK_WEBHOOK_ALLOW_HTTP=false
HELPDESK_WEBHOOK_TIMEOUT_SECONDS=10
HELPDESK_WEBHOOK_MAX_ATTEMPTS=8
HELPDESK_WEBHOOK_SECRET_N8N=replace-with-a-dedicated-webhook-signing-secret

# Optional: require `Authorization: Bearer <token>` on GET /metrics. Leave
# unset to leave /metrics open at the application layer (the conventional
# setup when a Prometheus scraper only has network-level access, e.g. an
# internal-only port/network policy) -- see helpdesktool/config.py.
# HELPDESK_METRICS_TOKEN=replace-with-a-dedicated-metrics-scrape-token

# Frontend OIDC login (optional, build-time -- frontend/src/auth/oidc.ts).
# Leave every one of these unset to keep the development login page active.
# Set VITE_OIDC_ISSUER and VITE_OIDC_CLIENT_ID (at minimum) to switch the
# frontend to a real OIDC provider via the Authorization Code + PKCE flow --
# register a public (no client secret) SPA client with your provider, with
# a redirect URI of <your frontend origin>/auth/callback.
# VITE_OIDC_ISSUER=https://your-tenant.example-idp.com/
# VITE_OIDC_CLIENT_ID=replace-with-your-spa-client-id
# VITE_OIDC_AUDIENCE=https://api.helpdesktool.example.com
# VITE_OIDC_REDIRECT_URI=https://app.helpdesktool.example.com/auth/callback
# VITE_OIDC_SCOPE=openid email profile

# Required outside development (HELPDESK_ENVIRONMENT != development). Any
# standards-compliant OIDC provider works — Auth0, Okta, Keycloak, AWS
# Cognito, Authentik, a self-hosted one, etc. Copy the issuer and jwks_uri
# values from your provider's <issuer>/.well-known/openid-configuration
# document; the audience is whatever identifier you register this API under
# with that provider. Leave unset for local development.
# HELPDESK_OIDC_ISSUER=https://your-tenant.example-idp.com/
# HELPDESK_OIDC_AUDIENCE=https://api.helpdesktool.example.com
# HELPDESK_OIDC_JWKS_URL=https://your-tenant.example-idp.com/.well-known/jwks.json

# Microsoft Teams channel adapter (helpdesktool/channels/teams.py), via
# Bot Framework. One value, platform-wide -- the single Azure Bot Service
# App ID this deployment registered, required as the audience on every
# inbound Bot Framework JWT regardless of which customer Microsoft 365
# tenant sent it. Leave unset to keep the Teams endpoint disabled (503).
# HELPDESK_TEAMS_BOT_APP_ID=replace-with-your-bot-framework-app-id
